# Security headers for hosts that read this file (Netlify, Cloudflare Pages); others ignore it.
# The site uses no inline scripts or styles and loads nothing from other sites, so the policy can be strict.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
/downloads/*
  Cache-Control: public, max-age=3600
